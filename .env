# ===========================================
# PostgreSQL Production Database Configuration
# ===========================================

# Production Database
POSTGRES_PROD_HOST=postgres-prod
POSTGRES_PROD_PORT=5432
POSTGRES_PROD_DATABASE=persons
POSTGRES_PROD_USER=program
POSTGRES_PROD_PASSWORD=prod_secret_password_2024
POSTGRES_PROD_DATA_PATH=./data/postgres_data

# External Port for Production (host machine)
POSTGRES_PROD_PORT_EXTERNAL=5433

# Production Connection String (for Railway/production deployment)
POSTGRES_PROD_CONNECTION_STRING=Host=postgres-prod;Port=5432;Database=persons;Username=program;Password=prod_secret_password_2024

# ===========================================
# PostgreSQL Settings (for Application)
# ===========================================
# These are used by the application to connect to the database
POSTGRESQL_CONNECTION_STRING=Host=postgres-prod;Port=5432;Database=persons;Username=program;Password=prod_secret_password_2024
POSTGRESQL_HOST=postgres-prod
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=persons
POSTGRESQL_USER=program
POSTGRESQL_PASSWORD=prod_secret_password_2024

# ===========================================
# PostgreSQL Test Database Configuration
# ===========================================

# Test Database
POSTGRES_TEST_HOST=postgres-test
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_DATABASE=test_persons
POSTGRES_TEST_USER=program
POSTGRES_TEST_PASSWORD=test
# Test database uses internal container storage (no volume)

# External Port for Test (host machine)
POSTGRES_TEST_PORT_EXTERNAL=5434

# Test Connection String (for local testing)
POSTGRES_TEST_CONNECTION_STRING=Host=postgres-test;Port=5432;Database=test_persons;Username=program;Password=test

# ===========================================
# Environment Variables for Tests
# ===========================================

# These are used by TestPostgresqlDatabaseContext fixture
TEST_POSTGRESQL_HOST=postgres-test
TEST_POSTGRESQL_PORT=5433
TEST_POSTGRESQL_DATABASE=test_persons
TEST_POSTGRESQL_USER=program
TEST_POSTGRESQL_PASSWORD=test
TEST_POSTGRESQL_CONNECTION_STRING=Host=postgres-test;Port=5432;Database=test_persons;Username=program;Password=test

# ===========================================
# Application Configuration
# ===========================================

# Database Provider (PostgreSQL, MySQL, SQLite, SQLServer)
# Change this to switch between different database providers
DATABASE_PROVIDER=POSTGRESQL

# Application Port
APP_HOST=0.0.0.0
APP_PORT=8080

# ASP.NET Core URL configuration
ASPNETCORE_URLS=http://+:8080

# Environment (Development/Production)
ASPNETCORE_ENVIRONMENT=Development

# ===========================================
# Docker Configuration
# ===========================================

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=dsp-project

# Image Tag
IMAGE_TAG=latest

# ===========================================
# Railway Configuration (for deployment)
# ===========================================

# Railway Project Name (set this to your actual Railway project name)
RAILWAY_PROJECT_NAME=your-project-name-here
RAILWAY_SERVICE_NAME=your-service-name-here
RAILWAY_TOKEN=your-railway-token-here
