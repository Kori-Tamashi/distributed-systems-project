					"script": {
						"exec": [
							"pm.test('Status is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Person data matches created data', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.equal(parseInt(pm.collectionVariables.get('createdPersonId')));",
