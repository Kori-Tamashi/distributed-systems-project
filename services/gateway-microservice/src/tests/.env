# =============================================================================
# GATEWAY-MICROSERVICE TEST ENVIRONMENT VARIABLES
# =============================================================================

# Test API URLs (ports from other microservices .env files)
# Note: Base URL without /api/v1 - gateways add the API path
FLIGHT_API_TEST_URL=http://localhost:8063
TICKET_API_TEST_URL=http://localhost:8073
BONUS_API_TEST_URL=http://localhost:8053

# Test Database Configuration
DATABASE_PROVIDER=PostgreSQL

# Test PostgreSQL Connection (from .env in gateway-microservice root)
POSTGRES_TEST_PORT=5442
POSTGRES_TEST_DATABASE=test_gateway
POSTGRES_TEST_USER=program
POSTGRES_TEST_PASSWORD=test
