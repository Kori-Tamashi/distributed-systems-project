    {
      "name": "03 Use Tokyo Airport (ID 7)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has correct structure', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name');",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('createdAirportId', jsonData.Id || jsonData.id);",
              "console.log('Using airport ID: ' + (jsonData.Id || jsonData.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "body": {},
        "url": {
          "raw": "{{baseUrl}}/api/v1/airports/7",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "airports",
            "7"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 Create Flight Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has correct structure', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('flightUid');",
              "    pm.expect(jsonData).to.have.property('flightNumber');",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('createdFlightId', jsonData.Id || jsonData.id);",
              "console.log('Created flight ID: ' + (jsonData.Id || jsonData.id));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var airportId = pm.collectionVariables.get('createdAirportId');",
              "if (!airportId) {",
              "    console.error('No airport created. Please run 03 Create Airport For Flight first.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"FlightNumber\": \"AFL031\",\n  \"DateTime\": \"2026-11-21T20:00:00Z\",\n  \"FromAirportId\": 7,\n  \"ToAirportId\": 52,\n  \"Price\": 1500\n}"
        },
