    {
      "name": "06 Get Privilege By ID Valid",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/privileges/{{createdPrivilegeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "privileges",
            "{{createdPrivilegeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK or 204 No Content', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "pm.test('Privilege data matches created data', function () {",
              "    if (pm.response.code === 200) { var jsonData = pm.response.json(); pm.expect(jsonData).to.exist; } // 204 No Content is also success",
              "    pm.expect(jsonData.id).to.equal(parseInt(pm.collectionVariables.get('createdPrivilegeId')));",
              "    pm.expect(jsonData.username).to.equal(pm.collectionVariables.get('testUsername'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
