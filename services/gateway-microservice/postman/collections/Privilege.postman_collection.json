  "item": [
    {
      "name": "01 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manage/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manage",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK or 204 No Content', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "pm.test('Response time is acceptable (< 1000ms)', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 GetAllPrivileges Empty",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/privileges",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "privileges"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK or 204 No Content', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "pm.test('Response contains items array', function () {",
              "    if (pm.response.code === 200) { var jsonData = pm.response.json(); pm.expect(jsonData).to.exist; } // 204 No Content is also success",
              "    // Array response - no items wrapper",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 Create Privilege Valid",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var timestamp = new Date().getTime();",
              "var uniqueUsername = 'testuser_' + timestamp;",
              "pm.collectionVariables.set('testUsername', uniqueUsername);",
              "console.log('Using unique username: ' + uniqueUsername);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has correct structure', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('username');",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('createdPrivilegeId', jsonData.Id || jsonData.id);",
              "console.log('Created privilege ID: ' + (jsonData.Id || jsonData.id));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"{{testUsername}}\",\n  \"Status\": 0,\n  \"Balance\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/privileges",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "privileges"
          ]
        }
      }
    },
