          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Response contains validation error', function () {",
              "    if (pm.response.code === 200) { var jsonData = pm.response.json(); pm.expect(jsonData).to.exist; } // 204 No Content is also success",
              "    // Error response format - checking for any error property",
