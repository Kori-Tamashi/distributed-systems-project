# Gateway Microservice Configuration
# ===================================

# Application Settings
DOTNET_ENVIRONMENT=Development
APP_NAME=Gateway Microservice
APP_VERSION=1.0.0

# API Settings
API_PORT=8080
API_URL=http://localhost:8080

# =============================================================================
# MICROSERVICE URLs (Gateway Configuration)
# =============================================================================
# These URLs are used by HTTP Gateways to communicate with other microservices
# Format: http://host:port/api/v1

# Bonus/Privilege Microservice URL
# Default: http://localhost:8050/api/v1
BONUS_URL=http://localhost:8050/api/v1

# Flight Microservice URL
# Default: http://localhost:8060/api/v1
FLIGHT_URL=http://localhost:8060/api/v1

# Ticket Microservice URL
# Default: http://localhost:8070/api/v1
TICKET_URL=http://localhost:8070/api/v1

# =============================================================================
# MICROSERVICE API-TEST URLs (for Integration Testing)
# =============================================================================
# These URLs are used by Gateways when running inside Docker containers
# Use host.docker.internal to access host machine from container

FLIGHT_API_TEST_URL=http://host.docker.internal:8063
TICKET_API_TEST_URL=http://host.docker.internal:8073
BONUS_API_TEST_URL=http://host.docker.internal:8053

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================

# Production Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5441
POSTGRES_DB=gateway
POSTGRES_USER=program
POSTGRES_PASSWORD=prod_secret_password_2024

# Test Database (for integration tests)
TEST_POSTGRESQL_HOST=localhost
TEST_POSTGRESQL_PORT=5442
TEST_POSTGRESQL_DB=test_gateway
TEST_POSTGRESQL_USER=program
TEST_POSTGRESQL_PASSWORD=test

# Connection Strings (auto-generated from above)
# Production: Host=localhost;Port=5441;Database=gateway;Username=program;Password=prod_secret_password_2024
# Test: Host=localhost;Port=5442;Database=test_gateway;Username=program;Password=test

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=Information
LOG_FORMAT=json
LOG_OUTPUT=console,file

# =============================================================================
# Timeout Configuration (seconds)
# =============================================================================
HTTP_TIMEOUT=30
DATABASE_TIMEOUT=10

# =============================================================================
# Retry Configuration
# =============================================================================
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
TEST_API_PORT=8043
