					"script": {
						"exec": [
							"pm.test('Status is 200 or 404', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
							"});",
							"",
							"pm.test('Flight data matches created data', function () {",
							"    var body = pm.response.json();",
							"    var id = body.Id !== undefined ? body.Id : body.id;",
							"    var num = body.FlightNumber !== undefined ? body.FlightNumber : body.flightNumber;",
							"    pm.expect(id).to.equal(parseInt(pm.collectionVariables.get('createdFlightId')));",
							"    pm.expect(num).to.equal('SU100');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
