			"name": "09 Update Flight Valid",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 200, 405, or 404', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 405, 404]);",
							"});",
							"",
							"if (pm.response.code === 200) {",
							"    pm.test('Flight data updated correctly', function () {",
							"        var body = pm.response.json();",
							"        var num = body.FlightNumber !== undefined ? body.FlightNumber : body.flightNumber;",
							"        var price = body.Price !== undefined ? body.Price : body.price;",
							"        pm.expect(num).to.equal('SU200');",
							"        pm.expect(price).to.equal(20000);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
