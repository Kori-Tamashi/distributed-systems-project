		{
			"name": "06 Get Ticket By ID Valid",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/tickets/{{createdTicketId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "v1", "tickets", "{{createdTicketId}}"]
