							"pm.test('Status is 200 OK or 204 No Content', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
							"});",
							"",
							"pm.test('Privilege data matches created data', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.equal(parseInt(pm.collectionVariables.get('createdPrivilegeId')));",
