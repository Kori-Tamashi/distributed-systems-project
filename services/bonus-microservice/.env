# Bonus Service Environment Variables

# ===========================================
# Application Configuration
# ===========================================

# Database Provider (PostgreSQL, MySQL, SQLite, SQLServer)
DATABASE_PROVIDER=POSTGRESQL

# Application Port
APP_HOST=0.0.0.0
APP_PORT=8050

# ASP.NET Core URL configuration
ASPNETCORE_URLS=http://+:8050

# Environment (Development/Production)
ASPNETCORE_ENVIRONMENT=Development

# ===========================================
# PostgreSQL Production Database Configuration
# ===========================================

# Production Database
POSTGRES_PROD_DATABASE=privileges
POSTGRES_PROD_USER=program
POSTGRES_PROD_PASSWORD=prod_secret_password_2024
POSTGRES_PROD_HOST=postgres-prod
POSTGRES_PROD_PORT=5432

# External Port for Production (host machine)
POSTGRES_PROD_PORT_EXTERNAL=5451

# Production Connection String
PRIVILEGE_CONNECTIONSTRINGS_DEFAULTCONNECTION="Host=postgres-prod;Port=5432;Database=privileges;Username=program;Password=prod_secret_password_2024"

# ===========================================
# PostgreSQL Test Database Configuration
# ===========================================

# Test Database
POSTGRES_TEST_DATABASE=test_privileges
POSTGRES_TEST_USER=program
POSTGRES_TEST_PASSWORD=test
POSTGRES_TEST_HOST=postgres-test
POSTGRES_TEST_PORT=5432

# External Port for Test (host machine)
POSTGRES_TEST_PORT_EXTERNAL=5452

# Test Connection String
TEST_POSTGRESQL_CONNECTION_STRING="Host=${POSTGRES_TEST_HOST};Port=${POSTGRES_TEST_PORT};Database=${POSTGRES_TEST_DATABASE};Username=${POSTGRES_TEST_USER};Password=${POSTGRES_TEST_PASSWORD}"

# ===========================================
# Environment Variables for Tests
# ===========================================

# These are used by TestPostgresqlDatabaseContext fixture
# For running tests from host machine (use localhost)
# For running tests inside Docker container (use postgres-test)
TEST_POSTGRESQL_HOST=localhost
TEST_POSTGRESQL_PORT=5452
TEST_POSTGRESQL_DATABASE=test_privileges
TEST_POSTGRESQL_USER=program
TEST_POSTGRESQL_PASSWORD=test

# ===========================================
# Docker Configuration
# ===========================================

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=bonus-microservice

# Image Tag
IMAGE_TAG=latest
TEST_APP_PORT=8053
